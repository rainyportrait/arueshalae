{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"paths": {
			"*": ["./node_modules/*"]
		}
	},
	"include": ["userscript/**/*", "build-userscript.ts"]
}
